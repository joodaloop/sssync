{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "warn",
    "no-console": "warn",
    "no-unused-private-class-members": "warn",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "import/no-cycle": "warn",
    "import/no-duplicates": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test-d.ts"],
      "rules": {
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "website/public"]
}
