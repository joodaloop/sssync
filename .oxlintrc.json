{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "warn",
    "no-console": "warn",
    "no-debugger": "error",
    "no-duplicate-imports": "off",
    "no-empty": "warn",
    "no-eval": "error",
    "no-fallthrough": "error",
    "no-implicit-coercion": "warn",
    "no-redeclare": "error",
    "no-shadow": "warn",
    "no-throw-literal": "error",
    "no-undefined": "off",
    "no-unreachable": "error",
    "no-unused-expressions": "error",
    "no-unused-private-class-members": "warn",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "prefer-object-spread": "warn",
    "prefer-template": "warn",
    "require-await": "warn",
    "import/consistent-type-specifier-style": ["warn", "prefer-top-level"],
    "import/no-cycle": "warn",
    "import/no-absolute-path": "error",
    "import/no-commonjs": "error",
    "import/no-default-export": "warn",
    "import/no-duplicates": "warn",
    "import/no-mutable-exports": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": "warn",
    "typescript/consistent-type-exports": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-import-type-side-effects": "warn",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/prefer-optional-chain": "warn",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-template-expressions": "warn",
    "typescript/switch-exhaustiveness-check": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/error-message": "warn",
    "unicorn/no-array-for-each": "warn",
    "unicorn/no-array-reduce": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/no-null": "off",
    "unicorn/no-useless-spread": "warn",
    "unicorn/prefer-array-find": "warn",
    "unicorn/prefer-at": "warn",
    "unicorn/prefer-includes": "warn",
    "unicorn/prefer-modern-dom-apis": "warn",
    "unicorn/prefer-number-properties": "warn",
    "unicorn/prefer-object-from-entries": "warn",
    "unicorn/prefer-set-has": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "unicorn/prefer-string-slice": "warn",
    "unicorn/throw-new-error": "warn",
    "oxc/approx-constant": "warn",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/bad-bitwise-operator": "warn",
    "oxc/bad-char-at-comparison": "error",
    "oxc/bad-comparison-sequence": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/bad-object-literal-comparison": "error",
    "oxc/bad-replace-all-arg": "error",
    "oxc/branches-sharing-code": "warn",
    "oxc/const-comparisons": "error",
    "oxc/double-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/misrefactored-assign-op": "warn",
    "oxc/missing-throw": "error",
    "oxc/no-accumulating-spread": "warn",
    "oxc/no-async-await": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-barrel-file": "off",
    "oxc/no-const-enum": "warn",
    "oxc/no-map-spread": "warn",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-this-in-exported-function": "warn",
    "oxc/number-arg-out-of-range": "error",
    "oxc/only-used-in-recursion": "warn",
    "oxc/uninvoked-array-callback": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Type-level schema/mutator machinery relies on `any` and casts internally
      // to keep the public types sound; the unsafe-* rules are noise here.
      "files": ["packages/sssync/src/schema/**/*.ts", "packages/sssync/src/mutators/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "website/public", "scripts/bundle-size.ts", "**/*.test.ts", "**/*.test-d.ts"]
}
