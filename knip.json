{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "packages/sssync": {
      "entry": [
        "src/*/index.ts",
        "src/schema/*.ts",
        "tests/**/*.test.ts",
        "tests/**/*.test-d.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreExportsUsedInFile": true
    },
    "packages/solid": {
      "entry": ["tests/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreExportsUsedInFile": true
    }
  }
}
